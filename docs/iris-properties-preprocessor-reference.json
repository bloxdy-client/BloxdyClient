  "sourceBehavior": "Pinned Iris class bytes install explicit macros and run property text through JCPP token processing with backslash protection. The listener does not exempt ordinary property lines from macro expansion. The nested pinned JCPP dependency maps addMacro(name) to literal 1.",
  "implementationScope": "Internal block.properties preparation into the existing immutable BlockIdMap. No ZIP/filesystem loader, GLSL preprocessor, translated program, production recipe or automatic activation.",
  "unknownPolicy": "Missing macro context is unknown and aborts preparation. A caller must explicitly supply defined values or known undefined (nullopt). This stricter guard does not claim that JCPP itself treats absent macros as unknown.",
  "subset": {
    "directives": [
      "if",
      "ifdef",
      "ifndef",
      "elif",
      "else",
      "endif",
      "define",
      "undef"
    ],
    "operators": [
      "defined",
      "!",
      "unary +",
      "unary -",
      "<",
      "<=",
      ">",
      ">=",
      "==",
      "!=",
      "&&",
      "||",
      "parentheses"
    ],
    "integerLiterals": [
      "signed 64-bit range",
      "decimal",
      "hexadecimal",
      "octal"
    ],
    "properties": "Defined object macros expand in ordinary key/value identifier tokens. Unknown or known-undefined literal property identifiers remain unchanged. Protected property escapes/pp-numbers and simple strings/comments are not macro names.",
    "unsupported": [
      "active includes/imports/pragma/line/error/warning",
      "function macros",
      "recursive macros",
      "generated defined operator",
      "continued/quoted directives",
      "multiline comments",
      "escaped property strings/hash/token pasting",
      "binary arithmetic/bitwise/shifts/ternary",
      "integer suffixes/unsigned ranges",
      "directives/comments inside continued properties"
    ]
  },
