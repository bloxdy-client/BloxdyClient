  "coverage": [
    {
      "variant": "ordinary terrain, including unit faces",
      "evidence": [
        "vertexBuilder",
        "workerReplyWithBlockCopies",
        "workerInitAndCompleteBoundary",
        "jobDispatch",
        "workerTerrainVertexStride"
      ],
      "status": "implemented-bounded",
      "missing": "Known per face after observed meshingInit and matching job/reply, with exact immutable bytes/indices and validated center-owned cell/register association. Different RGB and known zero may coexist in one group. Boundary-owner cells outside the center, missing initializations, unsupported layouts, mutations or budget excess stay unknown."
    },
    {
      "variant": "greedy faces",
      "evidence": [
        "greedySelection",
        "workerOwnVersusPropagated",
        "centerBlockCopyAndNeighbours"
      ],
      "status": "implemented-bounded",
      "missing": "Every contributing cell is explicitly checked using mesher face origin, axis, width and height. Only a fully proven uniform rectangle is known. A mixed/ambiguous rectangle remains unknown while adjacent proven faces remain usable. No merge/material/propagated-light heuristic or interpolation."
    },
    {
      "variant": "material groups and compact/submesh remapping",
      "evidence": [
        "vertexBuilder",
        "meshAssignment",
        "workerTerrainVertexStride"
      ],
      "status": "implemented-bounded",
      "missing": "terrainID joins returned face groups to exact returned storage, never to a block ID. Each exported triangle maps all three distinct vertices through vertexMap to one source face and the exact source index slice. Homogeneous subsets of mixed groups are recovered. Constant RGB/validity per dense index run in actual world/shadow draws; compact-only stand-ins remain unknown."
    },
    {
      "variant": "object/thin instances",
      "evidence": [
        "instanceLifetimeStorage",
        "instanceOwnershipManager",
        "instanceRegistryOverwrite",
